<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container">
  <section class="card receipt-card">
    <div class="receipt-header">
      <h1>Barako Brew</h1>
      <p class="muted">Coffee Shop Receipt</p>
    </div>
    <div class="receipt-details">
      <div><strong>Receipt No.</strong><span><%= sale.receipt_no %></span></div>
      <div><strong>Queue No.</strong><span><%= sale.queue_no %></span></div>
      <div><strong>Order Type</strong><span><%= sale.order_type %></span></div>
      <div><strong>Date</strong><span><%= new Date(sale.created_at).toLocaleString('en-PH', { dateStyle: 'medium', timeStyle: 'short' }) %></span></div>
      <div><strong>Cashier</strong><span><%= sale.cashier_name || 'Unknown' %></span></div>
    </div>
    <div class="table-scroll">
      <table class="table">
        <thead><tr><th>Item</th><th>Qty</th><th>Price</th><th>Subtotal</th></tr></thead>
        <tbody>
          <% items.forEach(item => { %>
            <tr><td><%= item.product_name %></td><td><%= item.quantity %></td><td><%= peso(item.unit_price) %></td><td><%= peso(item.subtotal) %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="receipt-total"><span>Total</span><strong><%= peso(sale.total_amount) %></strong></div>
    <div class="receipt-summary"><span>Amount Paid</span><span><%= peso(sale.amount_paid) %></span></div>
    <div class="receipt-summary"><span>Change</span><span><%= peso(sale.change_amount) %></span></div>
    <a class="btn btn-primary btn-block" href="/pos">New Sale</a>
  </section>
</main>
<%- include('../partials/foot') %>
